# [!NOTE]
# Read the `docs/configuration_guide.md` carefully, and update the
# configurations to match your specific settings and requirements.
# - Replace `api_key` with your own credentials.
# - Replace `base_url` and `model` name if you want to use a custom model.
# - Set `verify_ssl` to `false` if your LLM server uses self-signed certificates
# - A restart is required every time you change the `conf.yaml` file.

BASIC_MODEL:
  base_url: https://ark.cn-beijing.volces.com/api/v3
  model: "doubao-1-5-pro-32k-250115"
  api_key: xxxx
  # max_retries: 3 # Maximum number of retries for LLM calls
  # verify_ssl: false  # Uncomment this line to disable SSL certificate verification for self-signed certificates

# Local model configuration example:

# Ollama (Tested and supported for local development)
# BASIC_MODEL:
#   base_url: "http://localhost:11434/v1"  # Ollama OpenAI compatible endpoint
#   model: "qwen3:14b"  # or "llama3.2", etc.
#   api_key: "ollama"  # Ollama doesn't need real API key
#   max_retries: 3
#   verify_ssl: false  # Local deployment usually doesn't need SSL verification

# Azure OpenAI Configuration Example:
# BASIC_MODEL:
#   model: "gpt-4o"
#   azure_endpoint: "https://your-resource-name.openai.azure.com/"
#   api_version: "2024-02-15-preview"
#   api_key: "your-azure-openai-api-key"
#   max_retries: 3
#   verify_ssl: true

# To use Google Ai Studio as your basic platform:
# BASIC_MODEL:
#   platform: "google_aistudio"
#   model: "gemini-2.5-flash"  # or "gemini-1.5-pro", "gemini-2.5-flash-exp", etc.
#   api_key: your_gemini_api_key  # Get from https://aistudio.google.com/app/apikey
#   max_retries: 3
 
# Reasoning model is optional.
# Uncomment the following settings if you want to use reasoning model
# for planning.

# REASONING_MODEL:
#   base_url: https://ark.cn-beijing.volces.com/api/v3
#   model: "doubao-1-5-thinking-pro-m-250428"
#   api_key: xxxx
#   max_retries: 3 # Maximum number of retries for LLM calls


# OTHER SETTINGS:
# 搜索引擎配置：区分学术搜索与通用搜索
# SEARCH_ENGINE：学术/默认搜索（可配置 include_domains 限制为学术站）
# SEARCH_ENGINE:
#   engine: tavily
#   include_domains:
#     - arxiv.org
#     - scholar.google.com
#     - example.com
#   exclude_domains:
#     - reddit.com
#
# GENERAL_SEARCH_ENGINE：通用搜索（计划执行、选题/热点、失败补救等），不限制学术站
# 可选引擎：bing, tavily, duckduckgo, brave_search
# 使用 Bing 时需在 ENV 中配置 BING_SUBSCRIPTION_KEY；可选 BING_SEARCH_URL
# GENERAL_SEARCH_ENGINE:
#   engine: bing
# GENERAL_SEARCH_ENGINE:
#   engine: tavily

# Deep Research Mode Configuration
# RESEARCH_MODE:
#   mode: deep_research  # standard | deep_research
#   max_iterations: 5
#   enable_synthesis: true
#   literature_focus: true  # 优先使用scholar工具
#   context_compression: true

# 文生视频 API（异步：POST 提交 -> 202 返回 file_id -> 轮询 GET 状态 -> GET 下载）
# VIDEO_GENERATION:
#   base_url: "http://localhost:8890"
#   api_key: "sk-xxx"
#   submit_path: "/v1/video/generations"
#   status_path: "/v1/video/files/{file_id}"
#   download_path: "/v1/video/files/{file_id}/download"
#   size: "1280*720"
#   poll_interval: 5
#   max_wait: 600
#   timeout: 60
#   output_dir: "temp/video_generations"
#   deferred_download_minutes: 30  # 提交后延迟 N 分钟再检查并下载（0 表示立即轮询）
# 兼容旧配置：也可用 url + status_url（完整 URL）

# 文本转语音 TTS 配置
# provider: edge_tts（开源，免 API key）| volcengine（火山引擎，需配置 ENV）
# TTS:
#   provider: edge_tts
#   edge_tts:
#     voice: "zh-CN-XiaoxiaoNeural"  # 中文女声；zh-CN-YunxiNeural 男声

# 文生图 API（供 image_generation_tool 调用），请求 POST {base_url}/v1/images/generations，响应为 PNG 二进制
# IMAGE_GENERATION:
#   base_url: "http://localhost:8889"
#   api_key: "sk-xxx"
#   height: 1024
#   width: 1024
#   num_inference_steps: 9
#   seed: 42
#   output_dir: "temp/image_generations"
#   timeout: 120
